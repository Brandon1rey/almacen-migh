# =============================================================================
# Variables de entorno para despliegue en Vercel + Supabase
# Copia este archivo a `.env` para pruebas locales con Supabase, o configura
# la variable en Vercel -> Project Settings -> Environment Variables.
# =============================================================================

# Cadena de conexión PostgreSQL de Supabase (Transaction Pooler puerto 6543 o Session puerto 5432).
# También se aceptan DATABASE_URL, POSTGRES_URL o POSTGRES_URL_NON_POOLING (integración Vercel-Supabase).
SUPABASE_DB_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Nivel de detalle en logs (INFO o DEBUG)
ALMACEN_LOG="INFO"
